# Settings for docker-compose.yml. Copy to .env.docker (git-ignored) and fill in.
# The image already sets APP_ENV=production, APP_DEBUG=false, LOG_CHANNEL=stderr and the SQLite path.

# Required. Generate once and keep it: docker compose run --rm app php artisan key:generate --show
APP_KEY=

APP_NAME="Tech Log"
APP_URL=http://localhost:8080

# Behind a TLS-terminating proxy (e.g. Caddy on the host): trust it and send secure cookies.
# 172.16.0.0/12 covers Docker's default bridge networks.
TRUSTED_PROXIES=
SESSION_SECURE_COOKIE=false

# A real mailer, or password-reset emails only reach the log.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="techlog@example.com"
MAIL_FROM_NAME="Tech Log"

# Optional app settings (see README "Deploying to a host").
TECHLOG_MCP_USER=
TECHLOG_MCP_TIMEZONE=UTC
TECHLOG_READ_KEY=
